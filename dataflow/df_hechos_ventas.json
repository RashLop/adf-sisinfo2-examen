{
	"name": "df_hechos_ventas",
	"properties": {
		"folder": {
			"name": "Gold"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "ds_sql_ventas_silver",
						"type": "DatasetReference"
					},
					"name": "ventas"
				},
				{
					"dataset": {
						"referenceName": "ds_sql_dim_clientes",
						"type": "DatasetReference"
					},
					"name": "CLIENTES"
				},
				{
					"dataset": {
						"referenceName": "ds_sql_dim_fecha_gold",
						"type": "DatasetReference"
					},
					"name": "FECHA"
				},
				{
					"dataset": {
						"referenceName": "ds_sql_dim_fecha_gold",
						"type": "DatasetReference"
					},
					"name": "FECHA2"
				},
				{
					"dataset": {
						"referenceName": "ds_sql_dim_productos_gold",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [],
			"transformations": [
				{
					"name": "join1"
				},
				{
					"name": "join2"
				},
				{
					"name": "join3"
				},
				{
					"name": "derivedColumn1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          sls_ord_num as string,",
				"          sls_prd_key as string,",
				"          sls_cust_id as string,",
				"          sls_order_dt as string,",
				"          sls_ship_dt as string,",
				"          sls_sales as integer,",
				"          sls_quantity as integer,",
				"          sls_price as integer",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> ventas",
				"source(output(",
				"          CST_ID as string,",
				"          CST_FIRSTNAME as string,",
				"          CST_LASTNAME as string,",
				"          CST_MARITAL_STATUS as string,",
				"          CST_GNRD as string,",
				"          CNTRY as string,",
				"          BDATE as date",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> CLIENTES",
				"source(output(",
				"          ID_FECHA as integer,",
				"          FECHA as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> FECHA",
				"source(output(",
				"          ID_FECHA as integer,",
				"          FECHA as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> FECHA2",
				"source(output(",
				"          PRD_KEY as string,",
				"          PRD_NM as string,",
				"          PRD_COST as string,",
				"          PRD_LINE as string,",
				"          CAT as string,",
				"          MAINTENANCE as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> source1",
				"ventas, CLIENTES join(sls_cust_id == CST_ID,",
				"     joinType:'inner',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> join1",
				"join1, FECHA join(sls_order_dt == FECHA,",
				"     joinType:'inner',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> join2",
				"join2, FECHA2 join(sls_ship_dt == FECHA2@FECHA,",
				"     joinType:'inner',",
				"     matchType:'exact',",
				"     ignoreSpaces: false,",
				"     broadcast: 'auto')~> join3",
				"source1 derive(PRD_KEY = substring(PRD_KEY, 6, length(PRD_KEY) - 6)) ~> derivedColumn1"
			]
		}
	}
}